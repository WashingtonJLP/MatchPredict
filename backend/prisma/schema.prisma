generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum FixtureStatus {
  NS
  LIVE
  FT
  POSTPONED
  CANCELLED
}

enum WinnerType {
  HOME
  AWAY
  DRAW
}

enum ParticipationPeriodStatus {
  OPEN
  CLOSED
}

enum ParticipationStatus {
  ACTIVE
  CANCELLED
}

enum PaymentMethod {
  PIX
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  FAILED
}

model User {
  id String @id @default(uuid()) @db.Uuid

  name     String
  email    String @unique
  password String

  role Role @default(USER)

  avatarUrl String? @map("avatar_url")

  resetPasswordToken     String?   @unique @map("reset_password_token")
  resetPasswordExpiresAt DateTime? @map("reset_password_expires_at")

  predictions    Prediction[]
  standings      Standing[]
  participations Participation[]
  payments       Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model ParticipationPeriod {
  id String @id @default(uuid()) @db.Uuid

  referenceYear  Int @map("reference_year")
  referenceMonth Int @map("reference_month")

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  participationFeeCents Int @map("participation_fee_cents")

  status ParticipationPeriodStatus @default(OPEN)

  participations Participation[]
  payments       Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([referenceYear, referenceMonth])
  @@map("participation_periods")
}

model Participation {
  id String @id @default(uuid()) @db.Uuid

  userId    String  @map("user_id") @db.Uuid
  periodId  String  @map("period_id") @db.Uuid
  paymentId String? @unique @map("payment_id") @db.Uuid

  status      ParticipationStatus @default(ACTIVE)
  activatedAt DateTime            @default(now()) @map("activated_at")

  user    User                @relation(fields: [userId], references: [id])
  period  ParticipationPeriod @relation(fields: [periodId], references: [id])
  payment Payment?            @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, periodId])
  @@index([userId, status])
  @@index([periodId])
  @@map("participations")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  userId   String @map("user_id") @db.Uuid
  periodId String @map("period_id") @db.Uuid

  amountCents Int           @map("amount_cents")
  currency    String        @default("BRL")
  method      PaymentMethod @default(PIX)
  status      PaymentStatus @default(PENDING)

  provider                  String
  providerPaymentId         String?   @unique @map("provider_payment_id")
  providerReference         String?   @map("provider_reference")
  providerEventId           String?   @unique @map("provider_event_id")
  providerCreationStartedAt DateTime? @map("provider_creation_started_at")
  pixCopyPaste              String?   @map("pix_copy_paste")
  pixQrCode                 String?   @map("pix_qr_code")

  expiresAt DateTime? @map("expires_at")
  paidAt    DateTime? @map("paid_at")

  user          User                @relation(fields: [userId], references: [id])
  period        ParticipationPeriod @relation(fields: [periodId], references: [id])
  participation Participation?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerReference])
  @@index([userId, createdAt])
  @@index([periodId])
  @@map("payments")
}

model League {
  id String @id @default(uuid()) @db.Uuid

  apiLeagueId Int @unique @map("api_league_id")

  name    String
  country String
  logo    String

  isActive Boolean @default(true) @map("is_active")

  seasons Season[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("leagues")
}

model Season {
  id String @id @default(uuid()) @db.Uuid

  leagueId String @map("league_id") @db.Uuid

  year Int

  name String

  isActive Boolean @default(true) @map("is_active")

  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  league League @relation(fields: [leagueId], references: [id])

  fixtures  Fixture[]
  standings Standing[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([leagueId, year])

  @@index([leagueId])

  @@map("seasons")
}

model Team {
  id String @id @default(uuid()) @db.Uuid

  apiTeamId Int @unique @map("api_team_id")

  name    String
  logo    String
  country String

  homeFixtures Fixture[] @relation("HomeTeam")
  awayFixtures Fixture[] @relation("AwayTeam")

  players Player[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teams")
}

model Fixture {
  id String @id @default(uuid()) @db.Uuid

  apiFixtureId Int @unique @map("api_fixture_id")

  seasonId String @map("season_id") @db.Uuid

  homeTeamId String @map("home_team_id") @db.Uuid
  awayTeamId String @map("away_team_id") @db.Uuid

  round Int

  kickoff DateTime

  status FixtureStatus @default(NS)

  homeGoals Int? @map("home_goals")
  awayGoals Int? @map("away_goals")

  winnerType WinnerType? @map("winner_type")

  processedAt DateTime? @map("processed_at")

  season Season @relation(fields: [seasonId], references: [id])

  homeTeam Team @relation("HomeTeam", fields: [homeTeamId], references: [id])

  awayTeam Team @relation("AwayTeam", fields: [awayTeamId], references: [id])

  predictions Prediction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([seasonId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([kickoff])
  @@map("fixtures")
}

model Prediction {
  id String @id @default(uuid()) @db.Uuid

  userId    String @map("user_id") @db.Uuid
  fixtureId String @map("fixture_id") @db.Uuid

  homeGoals Int @map("home_goals")
  awayGoals Int @map("away_goals")

  mvpPlayerId String? @map("mvp_player_id") @db.Uuid

  scorePoints Int @default(0) @map("score_points")
  mvpPoints   Int @default(0) @map("mvp_points")
  totalPoints Int @default(0) @map("total_points")

  exactScore    Boolean @default(false) @map("exact_score")
  correctWinner Boolean @default(false) @map("correct_winner")
  correctMvp    Boolean @default(false) @map("correct_mvp")

  user User @relation(fields: [userId], references: [id])

  fixture Fixture @relation(fields: [fixtureId], references: [id])

  mvpPlayer Player? @relation(fields: [mvpPlayerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, fixtureId])
  @@index([fixtureId])
  @@index([userId])
  @@index([mvpPlayerId])
  @@map("predictions")
}

model Standing {
  id String @id @default(uuid()) @db.Uuid

  seasonId String @map("season_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  scorePoints      Int @default(0) @map("score_points")
  mvpPoints        Int @default(0) @map("mvp_points")
  adjustmentPoints Int @default(0) @map("adjustment_points")
  totalPoints      Int @default(0) @map("total_points")

  exactScores    Int @default(0) @map("exact_scores")
  correctWinners Int @default(0) @map("correct_winners")
  correctMvps    Int @default(0) @map("correct_mvps")

  wrongPredictions Int @default(0) @map("wrong_predictions")

  position Int @default(1)

  user User @relation(fields: [userId], references: [id])

  season Season @relation(fields: [seasonId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([seasonId, userId])
  @@index([seasonId])
  @@map("standings")
}

model SyncLog {
  id String @id @default(uuid()) @db.Uuid

  entity String

  status String

  message String?

  startedAt DateTime @map("started_at")

  finishedAt DateTime? @map("finished_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("sync_logs")
}

model Player {
  id String @id @default(uuid()) @db.Uuid

  apiPlayerId Int @unique @map("api_player_id")

  teamId String @map("team_id") @db.Uuid

  name String

  number Int?

  photo String?

  position String?

  team Team @relation(fields: [teamId], references: [id])

  predictions Prediction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([teamId])
  @@map("players")
}
